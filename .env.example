# ============================================================
# DocuIA — Environment Variables
# Copy to .env.local for local development
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DocuIA

# --- PostgreSQL (new database — separate from MeraIA) ---
DATABASE_URL=postgresql://docuia_user:change_me@localhost:5432/docuia

# --- Encryption (credentials at rest) ---
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_64_char_hex_string_generate_with_openssl_rand_hex_32

# --- JWT Auth ---
JWT_SECRET=change_me_min_32_chars_random_string
REFRESH_SECRET=change_me_a_different_min_32_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google Gemini AI ---
# Either name works (GOOGLE_API_KEY wins when both are set). A tenant can
# also bring its own key from the admin panel.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Workflow pipeline ---
# Minimum confidence (0–1) to auto-process without human review. Default: 0.85
WORKFLOW_AUTO_PROCESS_THRESHOLD=0.85

# --- MinIO (document storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=docuia-documents
MINIO_USE_SSL=false
# MINIO_REGION=us-east-1

# --- Resend (email) ---
RESEND_API_KEY=re_...
# Where landing-page demo requests are sent.
CONTACT_EMAIL=ventas@docuia.com

# --- Internal cron authentication ---
# Header sent by your cron scheduler: X-Cron-Secret: <value>
CRON_SECRET=change_me_min_32_chars_random_string

# --- Platform Admin (seed) ---
# Used only on first run to create the super-admin account
PLATFORM_ADMIN_EMAIL=admin@docuia.com
PLATFORM_ADMIN_PASSWORD=change_me_strong_password

# --- Pipeline timeouts & queue (optional; sensible defaults shown) ---
# Hard caps on external calls so a hung provider never blocks a job/request.
GEMINI_TIMEOUT_MS=90000
NETSUITE_TIMEOUT_MS=30000
# Watchdog: docs stuck in a transient status longer than this are failed.
# Wire your scheduler to GET /api/internal/cron/reap-stuck (X-Cron-Secret).
# Contract renewal/expiry alerts: GET /api/internal/cron/contract-alerts (X-Cron-Secret).
STUCK_DOC_MINUTES=15
# The document pipeline runs in an in-process pg-boss worker (started via
# instrumentation.ts) when the tenant has document_storage enabled; otherwise
# it falls back to inline processing. pg-boss uses DATABASE_URL — no extra config.
# Documents processed in parallel per app instance (1–10).
PIPELINE_CONCURRENCY=3
# Internal cron schedules (reap-stuck, auto-sync, retention, reports, alerts)
# run inside the app; set to false if an external scheduler calls the crons.
# INTERNAL_SCHEDULER_ENABLED=true
# Sin proxy confiable, las cabeceras IP del cliente no se aceptan.
TRUSTED_PROXY_HOPS=0
